---
import Base from '../../layouts/Base.astro';
import CatTile from '../../components/CatTile.astro';
import { CATEGORIES } from '../../categories.js';

export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'ko' } }]; }
const { lang } = Astro.params;
const tools = Object.values(import.meta.glob('../../tools/*/meta.json', { eager: true })).map((m) => m.default);
const groups = Object.keys(CATEGORIES).map((c) => [c, tools.filter((x) => x.category === c)]).filter(([, l]) => l.length);
const bySlug = (s) => tools.find((x) => x.slug === s);
const jump = ['soap-lye-calculator', 'candle-fragrance-load', 'yarn-yardage', '3d-print-cost'].map(bySlug);
const n = tools.length;
const crafts = groups.length;
const t = {
  en: {
    title: 'Craft Numbers – Free Calculators for Candle, Soap, Resin, Yarn and 3D Printing Makers',
    description: 'Free browser-based calculators for people who make and sell handmade goods: fragrance load, lye, resin volume, yarn yardage, 3D print cost and pricing.',
    eyebrow: 'Free calculators for makers', h1: ['Measure twice.', 'Pour once.'],
    lead: 'Recipe, material and pricing calculators for candles, soap, resin, yarn, sewing and 3D printing. Every formula is on the page, and nothing you type leaves your browser.',
    search: 'Search calculators', placeholder: 'Search calculators — try lye, yarn or filament', go: 'Search', jump: 'Jump to',
    found: (k) => `${k} calculator${k === 1 ? '' : 's'} found`,
    ex: { title: 'Candle fragrance load', tag: 'Example', wax: 'Wax', load: 'Fragrance load', out: 'Fragrance oil to add', total: 'Total batch', open: 'Open this calculator' },
    pick: 'Pick your craft', pickSub: `${n} calculators across ${crafts} crafts, each with its formula and a worked example.`,
    request: 'Request a calculator', count: (k) => `${k} calculator${k === 1 ? '' : 's'}`,
    missing: 'Missing your craft?', missingSub: 'Tell us what you need to work out, and it goes on the list.', email: 'Email a request',
    none: 'No calculator matches that yet. Try another word, or request it.',
    features: [
      ['Formulas, not black boxes', 'Every page shows its formula and a worked example, so you can check the math against your own notes.'],
      ['Stays in your browser', 'Calculations run on your device. Nothing you type is uploaded or saved.'],
      ['English and 한국어', 'Every calculator is available in both languages, with the same formulas.'],
    ],
  },
  ko: {
    title: 'Craft Numbers – 캔들·비누·레진·뜨개·3D프린팅 무료 계산기',
    description: '핸드메이드 제작·판매자를 위한 무료 계산기 모음: 향료 비율, 가성소다, 레진 부피, 실 분량, 3D 프린팅 원가와 판매가.',
    eyebrow: '메이커를 위한 무료 계산기', h1: ['두 번 재고,', '한 번에 붓기.'],
    lead: '캔들, 비누, 레진, 뜨개, 재봉, 3D 프린팅을 위한 레시피·재료·판매가 계산기입니다. 모든 계산식을 페이지에 공개하고, 입력값은 브라우저 밖으로 나가지 않습니다.',
    search: '계산기 검색', placeholder: '계산기 검색 — 가성소다, 실, 필라멘트', go: '검색', jump: '바로가기',
    found: (k) => `계산기 ${k}개를 찾았습니다`,
    ex: { title: '캔들 향료 비율', tag: '예시', wax: '왁스', load: '향료 비율', out: '넣을 향료 양', total: '전체 배치', open: '이 계산기 열기' },
    pick: '공예 고르기', pickSub: `계산기 ${n}개, 공예 ${crafts}종. 모든 계산기에 계산식과 예시가 있습니다.`,
    request: '계산기 요청하기', count: (k) => `계산기 ${k}개`,
    missing: '찾는 공예가 없나요?', missingSub: '계산하고 싶은 것을 알려 주시면 목록에 올립니다.', email: '메일로 요청하기',
    none: '아직 맞는 계산기가 없습니다. 다른 단어로 찾거나 요청해 주세요.',
    features: [
      ['계산식을 숨기지 않습니다', '모든 페이지에 계산식과 계산 예시가 있어서 내 노트와 직접 대조할 수 있습니다.'],
      ['브라우저에서만 계산합니다', '계산은 내 기기에서 이루어지고, 입력한 값은 업로드되거나 저장되지 않습니다.'],
      ['English와 한국어', '모든 계산기를 두 언어로, 같은 계산식으로 제공합니다.'],
    ],
  },
}[lang];
const featureIcons = [
  '<rect x="2.5" y="7" width="19" height="10" rx="1.5"/><path d="M6.5 7v3M10.5 7v4M14.5 7v3M18.5 7v4"/>',
  '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>',
];
// Search matches either language, so a Korean visitor can type English and the reverse.
const keys = (m) => [m.en.title, m.ko.title, m.en.short, m.ko.short, m.en.tagline, m.ko.tagline, CATEGORIES[m.category].en, CATEGORIES[m.category].ko].join(' ').toLowerCase();
---
<Base lang={lang} title={t.title} description={t.description} path="" bodyClass="home">
  <section class="hero mat">
    <div class="ruler" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="display">{t.h1.map((line) => <span>{line}</span>)}</h1>
        <p class="hero-lead">{t.lead}</p>
        <form class="search" role="search" id="search">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4F5C55" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <label class="sr" for="q">{t.search}</label>
          <input id="q" type="search" autocomplete="off" placeholder={t.placeholder} />
          <button type="submit" class="btn btn-marker">{t.go}</button>
        </form>
        <p class="sr" id="search-status" aria-live="polite" data-found={t.found(0)} data-found-one={t.found(1)}></p>
        <div class="chips">
          <span>{t.jump}</span>
          {jump.map((j) => <a class="chip-light" href={`/${lang}/${j.slug}/`}>{j[lang].short}</a>)}
        </div>
      </div>
      <div class="example">
        <div class="example-head"><span>{t.ex.title}</span><small>{t.ex.tag}</small></div>
        <div class="example-in">
          <div><p>{t.ex.wax}</p><b>500 g</b></div>
          <div><p>{t.ex.load}</p><b>8 %</b></div>
        </div>
        <div class="ruler" aria-hidden="true"></div>
        <div class="example-out">
          <div><p>{t.ex.out}</p><p class="big">40.0<span>g</span></p></div>
          <div class="example-total"><span>{t.ex.total}</span><span class="num">540.0 g</span></div>
          <a class="btn btn-ghost-light" href={`/${lang}/candle-fragrance-load/`}>{t.ex.open} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" id="tools">
    <div class="section-head">
      <div>
        <h2 class="display">{t.pick}</h2>
        <p>{t.pickSub}</p>
      </div>
      <a href={`/${lang}/contact/`}>{t.request} →</a>
    </div>
    <div class="cats">
      {groups.map(([c, list]) => (
        <article class="cat" id={c} data-cat>
          <div class="cat-head">
            <CatTile cat={c} />
            <div><h3>{CATEGORIES[c][lang]}</h3><p class="num">{t.count(list.length)}</p></div>
          </div>
          <ul>
            {list.map((m) => <li data-k={keys(m)}><a href={`/${lang}/${m.slug}/`}>{m[lang].short}<span aria-hidden="true">→</span></a></li>)}
          </ul>
        </article>
      ))}
      <article class="cat cat-request">
        <div><h3>{t.missing}</h3><p>{t.missingSub}</p></div>
        <a href={`/${lang}/contact/`}>{t.email} →</a>
      </article>
    </div>
    <p class="no-results" id="no-results" hidden>{t.none}</p>
  </section>

  <section class="features">
    <div class="ruler-ink" aria-hidden="true"></div>
    <div class="wrap">
      {t.features.map(([h, p], k) => (
        <div>
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#1E6B53" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={featureIcons[k]} />
          <h3>{h}</h3>
          <p>{p}</p>
        </div>
      ))}
    </div>
  </section>
  <div class="ad"></div>
</Base>

<script>
  const form = document.getElementById('search');
  const q = document.getElementById('q');
  const status = document.getElementById('search-status');
  const none = document.getElementById('no-results');
  const rows = [...document.querySelectorAll('li[data-k]')];

  function filter() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const li of rows) {
      li.hidden = Boolean(term) && !li.dataset.k.includes(term);
      if (!li.hidden) shown++;
    }
    for (const card of document.querySelectorAll('[data-cat]')) card.hidden = !card.querySelector('li:not([hidden])');
    none.hidden = shown > 0;
    status.textContent = !term ? '' : shown === 1 ? status.dataset.foundOne : status.dataset.found.replace('0', String(shown));
    return rows.filter((li) => !li.hidden);
  }

  q.addEventListener('input', filter);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const hits = filter();
    if (q.value.trim() && hits.length === 1) location.href = hits[0].querySelector('a').href;
    else document.getElementById('tools').scrollIntoView({ behavior: 'smooth' });
  });
</script>
