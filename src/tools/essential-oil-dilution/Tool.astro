---
import Field from '../../components/Field.astro';
import Step from '../../components/Step.astro';
import Seg from '../../components/Seg.astro';
import Readout from '../../components/Readout.astro';
const { lang } = Astro.props;
const t = {
  en: { warn: 'For external use only.', warnRest: 'Some essential oils have much lower safe limits than these general dilutions. Check your supplier’s maximum for each oil, patch-test, and take advice for children, pregnancy or medical conditions.', s1: 'Carrier', s2: 'Dilution', unit: 'Volume unit', amount: 'Carrier oil, lotion or base', pct: 'Dilution', pctHint: 'Common guidance for adults: 0.5–1% for the face and sensitive skin, 1–3% for body products.', dpm: 'Drops per ml', dpmHint: 'Charts assume 20. Droppers vary from about 20 to 30.', drops: 'Essential oil to add', eo: 'Essential oil volume', ml: 'Carrier volume', dropsUnit: 'drops' },
  ko: { warn: '외용으로만 사용하세요.', warnRest: '일부 에센셜 오일은 이 일반 농도보다 안전 한도가 훨씬 낮습니다. 오일별 최대 농도를 판매처에서 확인하고, 패치 테스트를 하며, 아이·임신·질환이 있다면 전문가와 상의하세요.', s1: '캐리어', s2: '희석 농도', unit: '부피 단위', amount: '캐리어 오일·로션·베이스 양', pct: '희석 농도', pctHint: '성인 기준 일반적인 농도: 얼굴·민감한 피부 0.5~1%, 바디 제품 1~3%.', dpm: '1 ml당 방울 수', dpmHint: '희석표는 대부분 20방울 기준입니다. 드로퍼에 따라 20~30방울까지 차이가 납니다.', drops: '넣을 에센셜 오일', eo: '에센셜 오일 부피', ml: '캐리어 부피', dropsUnit: '방울' },
}[lang];
const units = [{ value: 'ml', label: 'ml' }, { value: 'floz', label: 'fl oz' }];
---
<form class="tool wrap" id="essential-oil-dilution">
  <div class="inputs">
    <div class="notice" role="note">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7A4E00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 20h20L12 3z"></path><path d="M12 10v4"></path><path d="M12 17.2v.1"></path></svg>
      <p><strong>{t.warn}</strong> {t.warnRest}</p>
    </div>
    <Step n="1" title={t.s1}>
      <Seg slot="head" name="unit" label={t.unit} options={units} />
      <div class="fields">
        <Field label={t.amount} name="amount" value="30" />
      </div>
    </Step>
    <Step n="2" title={t.s2}>
      <div class="fields">
        <Field label={t.pct} name="pct" value="2" unit="%" max="10" step="0.1" presets={[0.5, 1, 2, 3, 5]} suffix="%" hint={t.pctHint} />
        <Field label={t.dpm} name="dpm" value="20" min="1" step="1" inputmode="numeric" hint={t.dpmHint} />
      </div>
    </Step>
  </div>
  <Readout lang={lang} items={[
    { label: t.drops, out: 'drops', unit: t.dropsUnit, size: 'xl' },
    { label: t.eo, out: 'eo', unit: 'ml', size: 'lg' },
    { label: t.ml, out: 'ml', unit: 'ml' },
  ]} />
</form>
<script>
  import { wire } from '../form.js';
  import { compute } from './calc.js';
  wire('essential-oil-dilution', compute);
</script>
