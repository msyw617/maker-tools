---
import Field from '../../components/Field.astro';
import Step from '../../components/Step.astro';
import Readout from '../../components/Readout.astro';
const { lang } = Astro.props;
const t = {
  en: { cur: undefined, s1: 'Cost of one item', s2: 'Markups', s3: 'Marketplace fees at retail', materials: 'Materials and packaging', minutes: 'Hands-on time', min: 'min', rate: 'Your hourly rate', overhead: 'Overhead share per item', overheadHint: 'Tools, studio, photography and shipping supplies, spread per item.', wholesaleX: 'Wholesale = cost ×', retailX: 'Retail = wholesale ×', feePct: 'Percentage fees', feeFixed: 'Fixed fee per order', feeHint: 'Example values. Check your marketplace’s current fee schedule.', retail: 'Retail price', profit: 'Profit after fees', labor: 'Labour', cost: 'Total cost', wholesale: 'Wholesale price', fees: 'Marketplace fees', note: 'Profit is on top of your hourly rate, which is already in the cost.' },
  ko: { cur: '원', s1: '작품 1개 원가', s2: '배수', s3: '소매 판매 시 플랫폼 수수료', materials: '재료비·포장비', minutes: '작업 시간', min: '분', rate: '내 시급', overhead: '작품당 간접비', overheadHint: '도구, 작업실, 사진 촬영, 배송 포장재를 작품 수로 나눈 몫.', wholesaleX: '도매가 = 원가 ×', retailX: '소매가 = 도매가 ×', feePct: '% 수수료', feeFixed: '건당 고정 수수료', feeHint: '예시 값입니다. 판매 플랫폼의 현재 수수료를 확인하세요.', retail: '소매가', profit: '수수료 뺀 이익', labor: '인건비', cost: '총 원가', wholesale: '도매가', fees: '플랫폼 수수료', note: '이익은 원가에 이미 들어 있는 내 시급과 별도입니다.' },
}[lang];
const d = lang === 'ko'
  ? { materials: 5000, rate: 12000, overhead: 1000, feePct: 10, feeFixed: 0 }
  : { materials: 5, rate: 20, overhead: 1, feePct: 9.5, feeFixed: 0.45 };
---
<form class="tool wrap" id="handmade-pricing">
  <div class="inputs">
    <Step n="1" title={t.s1}>
      <div class="fields">
        <Field label={t.materials} name="materials" value={d.materials} unit={t.cur} />
        <Field label={t.minutes} name="minutes" value="30" unit={t.min} />
        <Field label={t.rate} name="rate" value={d.rate} unit={t.cur} />
        <Field label={t.overhead} name="overhead" value={d.overhead} unit={t.cur} hint={t.overheadHint} />
      </div>
    </Step>
    <Step n="2" title={t.s2}>
      <div class="fields">
        <Field label={t.wholesaleX} name="wholesaleX" value="2" min="1" step="0.1" presets={[2, 2.5, 3]} />
        <Field label={t.retailX} name="retailX" value="2" min="1" step="0.1" presets={[2, 2.5, 3]} />
      </div>
    </Step>
    <Step n="3" title={t.s3}>
      <div class="fields">
        <Field label={t.feePct} name="feePct" value={d.feePct} unit="%" max="50" step="0.1" />
        <Field label={t.feeFixed} name="feeFixed" value={d.feeFixed} unit={t.cur} hint={t.feeHint} />
      </div>
    </Step>
  </div>
  <Readout lang={lang} note={t.note} items={[
    { label: t.retail, out: 'retail', unit: t.cur, size: 'xl' },
    { label: t.profit, out: 'profit', unit: t.cur, size: 'lg' },
    { label: t.labor, out: 'labor', unit: t.cur },
    { label: t.cost, out: 'cost', unit: t.cur },
    { label: t.wholesale, out: 'wholesale', unit: t.cur },
    { label: t.fees, out: 'fees', unit: t.cur },
  ]} />
</form>
<script>
  import { wire } from '../form.js';
  import { compute } from './calc.js';
  wire('handmade-pricing', compute);
</script>
