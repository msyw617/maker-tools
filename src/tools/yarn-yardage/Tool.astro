---
import Field from '../../components/Field.astro';
import Step from '../../components/Step.astro';
import Seg from '../../components/Seg.astro';
import Readout from '../../components/Readout.astro';
const { lang } = Astro.props;
const t = {
  en: { s1: 'Your swatch', s2: 'Yarn label', s3: 'Project', dunit: 'Size unit', lunit: 'Length unit', sw: 'Swatch width', sh: 'Swatch height', sweight: 'Swatch weight', swHint: 'Block the swatch the way you will block the project before measuring and weighing it.', kweight: 'Skein weight', klen: 'Skein length', pw: 'Finished width', pl: 'Finished length', pieces: 'Identical pieces', piecesHint: 'For a garment, enter each piece as a rectangle and add up the results.', extra: 'Extra allowance', skeins: 'Skeins to buy', length: 'Yarn needed', grams: 'Weight' },
  ko: { s1: '내 스와치', s2: '실 라벨', s3: '작품', dunit: '크기 단위', lunit: '길이 단위', sw: '스와치 가로', sh: '스와치 세로', sweight: '스와치 무게', swHint: '작품과 같은 방식으로 블로킹한 뒤 크기를 재고 무게를 다세요.', kweight: '한 타래 무게', klen: '한 타래 길이', pw: '완성 가로', pl: '완성 세로', pieces: '같은 조각 수', piecesHint: '옷은 조각마다 사각형으로 입력해서 결과를 더하세요.', extra: '여유분', skeins: '구매할 타래 수', length: '필요한 실 길이', grams: '무게' },
}[lang];
const dunits = [{ value: 'cm', label: 'cm' }, { value: 'in', label: 'in' }];
const lunits = [{ value: 'm', label: 'm' }, { value: 'yd', label: 'yd' }];
---
<form class="tool wrap" id="yarn-yardage">
  <div class="inputs">
    <Step n="1" title={t.s1}>
      <Seg slot="head" name="dunit" label={t.dunit} options={dunits} />
      <div class="fields">
        <Field label={t.sw} name="sw" value="10" unitOut="dunit" />
        <Field label={t.sh} name="sh" value="10" unitOut="dunit" />
        <Field label={t.sweight} name="sweight" value="5" unit="g" hint={t.swHint} />
      </div>
    </Step>
    <Step n="2" title={t.s2}>
      <Seg slot="head" name="lunit" label={t.lunit} options={lunits} />
      <div class="fields">
        <Field label={t.kweight} name="kweight" value="100" unit="g" />
        <Field label={t.klen} name="klen" value="200" unitOut="lunit" />
      </div>
    </Step>
    <Step n="3" title={t.s3}>
      <div class="fields">
        <Field label={t.pw} name="pw" value="50" unitOut="dunit" />
        <Field label={t.pl} name="pl" value="150" unitOut="dunit" />
        <Field label={t.pieces} name="pieces" value="1" min="1" step="1" inputmode="numeric" hint={t.piecesHint} />
        <Field label={t.extra} name="extra" value="10" unit="%" max="50" step="1" presets={[10, 15, 20]} suffix="%" />
      </div>
    </Step>
  </div>
  <Readout lang={lang} items={[
    { label: t.skeins, out: 'skeins', size: 'xl' },
    { label: t.length, out: 'length', unitOut: 'lunit', size: 'lg' },
    { label: t.grams, out: 'grams', unit: 'g' },
  ]} />
</form>
<script>
  import { wire } from '../form.js';
  import { compute } from './calc.js';
  wire('yarn-yardage', compute);
</script>
