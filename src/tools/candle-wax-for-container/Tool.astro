---
import Field from '../../components/Field.astro';
import Step from '../../components/Step.astro';
import Seg from '../../components/Seg.astro';
import Readout from '../../components/Readout.astro';
const { lang } = Astro.props;
const t = {
  en: { s1: 'Your container', s2: 'Batch', unit: 'Weight unit', water: 'Water weight per container', waterHint: 'Fill one container with water to where the candle surface will sit, then weigh the water.', wax: 'Wax type', soy: 'Soy wax (0.86)', coco: 'Coconut or coconut blend (0.89)', para: 'Paraffin (0.92)', count: 'Number of containers', load: 'Fragrance load', fill: 'Candle weight per container', waxOut: 'Wax to melt', fo: 'Fragrance oil to add', total: 'Total batch weight', note: 'Density factors are averages. Pour one test candle in a new container to confirm the fill line.' },
  ko: { s1: '용기', s2: '배치', unit: '무게 단위', water: '용기 1개에 들어가는 물 무게', waterHint: '캔들 표면이 올 높이까지 용기에 물을 채운 뒤 물 무게를 잽니다.', wax: '왁스 종류', soy: '소이 왁스 (0.86)', coco: '코코넛·코코넛 블렌드 (0.89)', para: '파라핀 (0.92)', count: '용기 수', load: '향료 비율', fill: '용기당 캔들 무게', waxOut: '녹일 왁스 양', fo: '넣을 향료 양', total: '전체 배치 무게', note: '밀도 계수는 평균값입니다. 새 용기는 테스트 캔들을 하나 만들어 채움선을 확인하세요.' },
}[lang];
const units = [{ value: 'g', label: 'g' }, { value: 'oz', label: 'oz' }];
const waxes = [{ value: 0.86, label: t.soy }, { value: 0.89, label: t.coco }, { value: 0.92, label: t.para }];
---
<form class="tool wrap" id="candle-wax-for-container">
  <div class="inputs">
    <Step n="1" title={t.s1}>
      <Seg slot="head" name="unit" label={t.unit} options={units} />
      <div class="fields">
        <Field label={t.water} name="water" value="200" unitOut="unit" hint={t.waterHint} />
        <Field label={t.wax} name="factor" value="0.86" options={waxes} />
      </div>
    </Step>
    <Step n="2" title={t.s2}>
      <div class="fields">
        <Field label={t.count} name="count" value="4" step="1" min="1" inputmode="numeric" />
        <Field label={t.load} name="load" value="8" unit="%" max="30" step="0.5" presets={[6, 8, 10]} suffix="%" />
      </div>
    </Step>
  </div>
  <Readout lang={lang} note={t.note} items={[
    { label: t.waxOut, out: 'wax', unitOut: 'unit', size: 'xl' },
    { label: t.fo, out: 'fo', unitOut: 'unit', size: 'lg' },
    { label: t.fill, out: 'fill', unitOut: 'unit' },
    { label: t.total, out: 'total', unitOut: 'unit' },
  ]} />
</form>
<script>
  import { wire } from '../form.js';
  import { compute } from './calc.js';
  wire('candle-wax-for-container', compute);
</script>
