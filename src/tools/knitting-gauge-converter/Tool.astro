---
import Field from '../../components/Field.astro';
import Step from '../../components/Step.astro';
import Readout from '../../components/Readout.astro';
const { lang } = Astro.props;
const t = {
  en: { s1: 'Stitches (width)', s2: 'Rows (length, optional)', pg: 'Pattern gauge', mg: 'Your gauge', per: 'per 10 cm / 4 in', ps: 'Stitches in the pattern', pr: 'Pattern row gauge', mr: 'Your row gauge', prow: 'Rows in the pattern', sts: 'Stitches to work', rows: 'Rows to work', width: 'Width if knit as written', length: 'Length if knit as written', note: 'A minus sign means the piece comes out smaller than the pattern; plus means larger.' },
  ko: { s1: '코 (폭)', s2: '단 (길이, 선택)', pg: '도안 게이지', mg: '내 게이지', per: '10 cm(4 in)당', ps: '도안의 코 수', pr: '도안 단 게이지', mr: '내 단 게이지', prow: '도안의 단 수', sts: '떠야 할 코 수', rows: '떠야 할 단 수', width: '도안대로 뜰 때 폭', length: '도안대로 뜰 때 길이', note: '음수(−)는 도안보다 작아진다는 뜻이고, 양수(+)는 커진다는 뜻입니다.' },
}[lang];
---
<form class="tool wrap" id="knitting-gauge-converter">
  <div class="inputs">
    <Step n="1" title={t.s1}>
      <div class="fields">
        <Field label={t.pg} name="pg" value="20" hint={t.per} />
        <Field label={t.mg} name="mg" value="22" hint={t.per} />
        <Field label={t.ps} name="ps" value="100" step="1" inputmode="numeric" />
      </div>
    </Step>
    <Step n="2" title={t.s2}>
      <div class="fields">
        <Field label={t.pr} name="pr" value="28" hint={t.per} />
        <Field label={t.mr} name="mr" value="30" hint={t.per} />
        <Field label={t.prow} name="prow" value="120" step="1" inputmode="numeric" />
      </div>
    </Step>
  </div>
  <Readout lang={lang} note={t.note} items={[
    { label: t.sts, out: 'sts', size: 'xl' },
    { label: t.rows, out: 'rows', size: 'lg' },
    { label: t.width, out: 'width', unit: '%', sign: true },
    { label: t.length, out: 'length', unit: '%', sign: true },
  ]} />
</form>
<script>
  import { wire } from '../form.js';
  import { compute } from './calc.js';
  wire('knitting-gauge-converter', compute);
</script>
