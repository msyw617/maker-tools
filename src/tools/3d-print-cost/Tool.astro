---
import Field from '../../components/Field.astro';
import Step from '../../components/Step.astro';
import Readout from '../../components/Readout.astro';
const { lang } = Astro.props;
const t = {
  en: { cur: undefined, s1: 'Filament', s2: 'Electricity', s3: 'Wear and failures (optional)', grams: 'Filament used', gramsHint: 'From your slicer’s summary.', spoolPrice: 'Spool price', spoolGrams: 'Spool weight', hours: 'Print time', watts: 'Average power draw', wattsHint: 'Most desktop printers average 100–150 W.', kwh: 'Price per kWh', printerPrice: 'Printer price', printerHint: 'Leave empty to skip wear.', lifeHours: 'Expected lifetime', fail: 'Failure rate', total: 'Cost per successful print', filament: 'Filament', power: 'Electricity', wear: 'Printer wear', note: 'Prices are in your own currency.' },
  ko: { cur: '원', s1: '필라멘트', s2: '전기료', s3: '감가상각·실패율 (선택)', grams: '필라멘트 사용량', gramsHint: '슬라이서 요약 화면의 값.', spoolPrice: '롤 가격', spoolGrams: '롤 무게', hours: '출력 시간', watts: '평균 소비전력', wattsHint: '데스크톱 프린터는 보통 평균 100~150 W.', kwh: 'kWh당 전기 요금', printerPrice: '프린터 가격', printerHint: '비워 두면 감가상각을 빼고 계산합니다.', lifeHours: '예상 수명', fail: '실패율', total: '성공 1개당 원가', filament: '필라멘트', power: '전기료', wear: '감가상각', note: undefined },
}[lang];
const d = lang === 'ko' ? { spoolPrice: 25000, kwh: 150, printerPrice: 500000 } : { spoolPrice: 20, kwh: 0.16, printerPrice: 300 };
const hr = lang === 'ko' ? '시간' : 'h';
---
<form class="tool wrap" id="3d-print-cost">
  <div class="inputs">
    <Step n="1" title={t.s1}>
      <div class="fields">
        <Field label={t.grams} name="grams" value="50" unit="g" hint={t.gramsHint} />
        <Field label={t.spoolPrice} name="spoolPrice" value={d.spoolPrice} unit={t.cur} />
        <Field label={t.spoolGrams} name="spoolGrams" value="1000" unit="g" />
      </div>
    </Step>
    <Step n="2" title={t.s2}>
      <div class="fields">
        <Field label={t.hours} name="hours" value="3" unit={hr} />
        <Field label={t.watts} name="watts" value="120" unit="W" hint={t.wattsHint} />
        <Field label={t.kwh} name="kwh" value={d.kwh} unit={t.cur} />
      </div>
    </Step>
    <Step n="3" title={t.s3}>
      <div class="fields">
        <Field label={t.printerPrice} name="printerPrice" value={d.printerPrice} unit={t.cur} hint={t.printerHint} />
        <Field label={t.lifeHours} name="lifeHours" value="5000" min="1" unit={hr} />
        <Field label={t.fail} name="fail" value="5" unit="%" max="90" step="1" presets={[0, 5, 10]} suffix="%" />
      </div>
    </Step>
  </div>
  <Readout lang={lang} note={t.note} items={[
    { label: t.total, out: 'total', unit: t.cur, size: 'xl' },
    { label: t.filament, out: 'filament', unit: t.cur },
    { label: t.power, out: 'power', unit: t.cur },
    { label: t.wear, out: 'wear', unit: t.cur },
  ]} />
</form>
<script>
  import { wire } from '../form.js';
  import { compute } from './calc.js';
  wire('3d-print-cost', compute);
</script>
