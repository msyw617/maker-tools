---
const { lang } = Astro.props;
const t = {
  en: { wax: 'Wax weight', load: 'Fragrance load (%)', fo: 'Fragrance oil to add', total: 'Total batch weight', note: 'Most waxes hold 6–10%. Check the maximum load on your wax data sheet.' },
  ko: { wax: '왁스 무게', load: '향료 비율 (%)', fo: '넣을 향료 양', total: '전체 배치 무게', note: '대부분의 왁스는 6~10%가 적정입니다. 왁스 제품 설명서의 최대 향료 비율을 확인하세요.' },
}[lang];
---
<form class="tool" id="candle-fragrance-load" onsubmit="return false">
  <label>{t.wax}
    <span class="row">
      <input name="wax" type="number" inputmode="decimal" min="0" step="any" value="500" />
      <select name="unit"><option value="g">g</option><option value="oz">oz</option></select>
    </span>
  </label>
  <label>{t.load}
    <input name="load" type="number" inputmode="decimal" min="0" max="30" step="0.5" value="8" />
  </label>
  <p class="result">{t.fo}: <strong data-out="fo"></strong> <span data-out="unit"></span></p>
  <p class="result">{t.total}: <strong data-out="total"></strong> <span data-out="unit"></span></p>
  <p class="note">{t.note}</p>
</form>
<script>
  import { wire } from '../form.js';
  import { compute } from './calc.js';
  wire('candle-fragrance-load', compute);
</script>
