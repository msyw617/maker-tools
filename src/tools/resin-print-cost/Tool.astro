---
import Field from '../../components/Field.astro';
import Step from '../../components/Step.astro';
import Readout from '../../components/Readout.astro';
const { lang } = Astro.props;
const t = {
  en: { cur: undefined, s1: 'Resin', s2: 'Electricity', s3: 'Consumables and failures', ml: 'Resin used', mlHint: 'From your slicer, with supports included.', bottlePrice: 'Bottle price', bottleMl: 'Bottle size', waste: 'Waste allowance', hours: 'Print time', watts: 'Average power draw', kwh: 'Price per kWh', extras: 'Cleaning and consumables per print', extrasHint: 'IPA or wash fluid, gloves, paper towels, and a share of FEP film and LCD wear.', fail: 'Failure rate', total: 'Cost per successful print', resin: 'Resin', power: 'Electricity', note: 'Prices are in your own currency.' },
  ko: { cur: '원', s1: '레진', s2: '전기료', s3: '소모품·실패율', ml: '레진 사용량', mlHint: '서포트를 포함한 슬라이서 값.', bottlePrice: '레진 한 병 가격', bottleMl: '병 용량', waste: '손실 여유분', hours: '출력 시간', watts: '평균 소비전력', kwh: 'kWh당 전기 요금', extras: '출력 1회당 세척·소모품', extrasHint: 'IPA나 세척액, 장갑, 키친타월, FEP 필름과 LCD 액정 소모분.', fail: '실패율', total: '성공 1개당 원가', resin: '레진', power: '전기료', note: undefined },
}[lang];
const d = lang === 'ko' ? { bottlePrice: 35000, kwh: 150, extras: 500 } : { bottlePrice: 30, kwh: 0.16, extras: 0.5 };
const hr = lang === 'ko' ? '시간' : 'h';
---
<form class="tool wrap" id="resin-print-cost">
  <div class="inputs">
    <Step n="1" title={t.s1}>
      <div class="fields">
        <Field label={t.ml} name="ml" value="30" unit="ml" hint={t.mlHint} />
        <Field label={t.bottlePrice} name="bottlePrice" value={d.bottlePrice} unit={t.cur} />
        <Field label={t.bottleMl} name="bottleMl" value="1000" unit="ml" />
        <Field label={t.waste} name="waste" value="10" unit="%" max="50" step="1" presets={[5, 10, 15]} suffix="%" />
      </div>
    </Step>
    <Step n="2" title={t.s2}>
      <div class="fields">
        <Field label={t.hours} name="hours" value="2" unit={hr} />
        <Field label={t.watts} name="watts" value="60" unit="W" />
        <Field label={t.kwh} name="kwh" value={d.kwh} unit={t.cur} />
      </div>
    </Step>
    <Step n="3" title={t.s3}>
      <div class="fields">
        <Field label={t.extras} name="extras" value={d.extras} unit={t.cur} hint={t.extrasHint} />
        <Field label={t.fail} name="fail" value="10" unit="%" max="90" step="1" presets={[5, 10, 20]} suffix="%" />
      </div>
    </Step>
  </div>
  <Readout lang={lang} note={t.note} items={[
    { label: t.total, out: 'total', unit: t.cur, size: 'xl' },
    { label: t.resin, out: 'resin', unit: t.cur },
    { label: t.power, out: 'power', unit: t.cur },
  ]} />
</form>
<script>
  import { wire } from '../form.js';
  import { compute } from './calc.js';
  wire('resin-print-cost', compute);
</script>
