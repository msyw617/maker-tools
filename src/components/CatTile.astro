---
import { CATEGORIES } from '../categories.js';
const { cat, size } = Astro.props;
const c = CATEGORIES[cat];
const px = size === 'lg' ? 30 : 24;
---
<span class={size === 'lg' ? 'tile tile-lg' : 'tile'} style={`background:${c.tint}`}>
  <svg width={px} height={px} viewBox="0 0 24 24" fill="none" stroke={c.ink} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
</span>
