---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/site.css';
import koFonts from '../styles/ko-fonts.css?url';

const { lang, title, description, path = '', bodyClass } = Astro.props;
const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const t = {
  en: { tools: 'Calculators', about: 'About', privacy: 'Privacy', contact: 'Contact', skip: 'Skip to content', tagline: 'Free calculators for people who make things by hand.' },
  ko: { tools: '계산기', about: '소개', privacy: '개인정보처리방침', contact: '문의', skip: '본문으로 건너뛰기', tagline: '손으로 만드는 사람들을 위한 무료 계산기.' },
}[lang];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1E4D3F" />
    {lang === 'ko' && <link rel="stylesheet" href={koFonts} media="print" onload="this.media='all'" />}
    <link rel="canonical" href={`${site}/${lang}/${path}`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/${path}`} />
    <link rel="alternate" hreflang="ko" href={`${site}/ko/${path}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/en/${path}`} />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`/${lang}/`}>
          <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><rect width="30" height="30" rx="7" fill="#1E4D3F"></rect><path d="M10 0v30M20 0v30M0 10h30M0 20h30" stroke="rgba(255,255,255,0.22)"></path><path d="M6 24 24 6" stroke="#F4C542" stroke-width="2.6" stroke-linecap="round"></path></svg>
          <span class="brand-name">Craft Numbers</span>
        </a>
        <nav class="nav" aria-label={t.tools}>
          <a href={`/${lang}/#tools`}>{t.tools}</a>
          <a href={`/${lang}/about/`}>{t.about}</a>
          <div class="lang">
            <a href={`/en/${path}`} lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
            <a href={`/ko/${path}`} lang="ko" hreflang="ko" aria-current={lang === 'ko' ? 'true' : undefined}>한국어</a>
          </div>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer mat">
      <div class="wrap">
        <div>
          <span class="brand-name">Craft Numbers</span>
          <p>{t.tagline}</p>
        </div>
        <nav aria-label="Footer">
          <a href={`/${lang}/about/`}>{t.about}</a>
          <a href={`/${lang}/privacy/`}>{t.privacy}</a>
          <a href={`/${lang}/contact/`}>{t.contact}</a>
          <small>© {new Date().getFullYear()} Craft Numbers</small>
        </nav>
      </div>
    </footer>
  </body>
</html>
